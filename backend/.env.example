PORT=5000
# Optional comma-separated bind addresses (unset = all interfaces). On macOS dev, uncomment:
# AirPlay Receiver already listens on *:5000 and would otherwise answer localhost:5000.
# HOST=127.0.0.1,::1
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shopkart
# At least 16 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=908727741603-rfddg0k2rt3dgp4v4napu5rv6qan01c6.apps.googleusercontent.com
RAZORPAY_KEY_ID=rzp_test_TnpOuMhoTxLpMj
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Empty in dev; .shopkart.spacesdrive.cc in production
COOKIE_DOMAIN=
# Optional: requests per minute per IP on login/register/google/change-password (default 20)
AUTH_RATE_LIMIT_MAX=20
# Storefront origin for links in emails (password reset, order emails)
APP_URL=https://shopkart.spacesdrive.cc
# Optional SMTP connection string (e.g. smtps://user:pass@smtp.example.com:465). Unset = emails are logged only.
SMTP_URL=
MAIL_FROM=ShopKart <hello@shopkart.spacesdrive.cc>
# Shown on invoices
SELLER_ADDRESS=ShopKart, India
SELLER_EMAIL=hello@shopkart.spacesdrive.cc
